; mongodbtop 서버 목록 예시. ~/.mongodbtop.ini 로 복사한 뒤 수정하세요.
;   cp mongodbtop.ini.example ~/.mongodbtop.ini && mongodbtop --list
; 비밀번호는 이 파일에 쓰지 않습니다 (password 키가 있으면 오류).
; MONGODBTOP_PASSWORD_<NAME> 환경변수, password_env, keyring, 또는 실행 시 입력으로 넘깁니다.

[defaults]
interval = 2
user = monitor            ; 모든 서버의 기본 사용자 (clusterMonitor 역할 필요)
auth_db = admin
; default = prod          ; 인자 없이 실행했을 때 접속할 서버 또는 그룹

[server:prod-rs]
uri = mongodb://db1:27017,db2:27017,db3:27017/?replicaSet=rs0
groups = prod
expand = members          ; 멤버마다 따로 모니터링

[server:prod-analytics]
uri = mongodb://db9:27017
groups = prod, analytics
password_env = ANALYTICS_PW   ; 이 서버의 비밀번호를 읽을 환경변수

[server:stage]
uri = mongodb://stage-db:27017
user = stage_monitor
